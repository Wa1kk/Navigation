<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IndoorNav.Pages.SplashPage"
             Title=""
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,*" VerticalOptions="Fill">
        <VerticalStackLayout Grid.Row="1" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
            <!-- Location pin icon -->
            <Border HorizontalOptions="Center"
                    BackgroundColor="#0E3A5F"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    WidthRequest="96" HeightRequest="96"
                    Padding="0">
                <Image Source="splash.svg"
                       WidthRequest="56" HeightRequest="56"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="IndoorNav"
                   FontSize="28" FontAttributes="Bold" TextColor="White"
                   HorizontalOptions="Center" Margin="0,8,0,0" />
            <Label Text="Навигация по зданиям"
                   FontSize="13" TextColor="#64748B"
                   HorizontalOptions="Center" Margin="0,0,0,32" />
            <ActivityIndicator IsRunning="True"
                               Color="#38BDF8"
                               WidthRequest="28" HeightRequest="28"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
