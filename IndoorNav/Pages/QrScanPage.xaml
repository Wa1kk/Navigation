<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="IndoorNav.Pages.QrScanPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1E293B">
    <Grid RowDefinitions="*,Auto">

        <!-- Illustration + text -->
        <Grid Grid.Row="0">
            <zxing:CameraBarcodeReaderView x:Name="CameraScanner"
                                           BarcodesDetected="OnBarcodesDetected" />
            <BoxView BackgroundColor="#66000000" />
            <Border WidthRequest="260"
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#38BDF8"
                    StrokeThickness="3"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 28" />
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Start"
                                 Margin="28,56,28,0"
                                 Spacing="6">
                <Label Text="Наведите камеру на QR-код"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Код будет распознан автоматически"
                       TextColor="#CBD5E1"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Action buttons -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="12"
                             Padding="24,20,24,52"
                             BackgroundColor="#1E293B"
                             ZIndex="10">
            <Button Text="Повторить сканирование"
                    Clicked="OnRestartScanClicked"
                    BackgroundColor="#0E7490" TextColor="White"
                    FontSize="15" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="14" />
            <Button Text="Выбрать из галереи"
                    Clicked="OnPickFromGalleryClicked"
                    BackgroundColor="#334155" TextColor="#E2E8F0"
                    FontSize="15" HeightRequest="52" CornerRadius="14" />
            <Button Text="Отмена"
                    Clicked="OnCloseClicked"
                    BackgroundColor="Transparent" TextColor="#94A3B8"
                    FontSize="14" HeightRequest="44" />
        </VerticalStackLayout>

        <!-- Close button -->
        <Button Text="✕"
                Clicked="OnCloseClicked"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="8,28,0,0"
                BackgroundColor="#80334155" TextColor="White"
                CornerRadius="22" WidthRequest="44" HeightRequest="44"
                FontSize="18" Padding="0" />

    </Grid>
</ContentPage>
